# Leave VITE_API_BASE_URL empty (or set to /api/v1) when using the Vite proxy in local dev.
# For production (Vercel), set it to your Render backend, e.g.:
# VITE_API_BASE_URL=https://ai-document-processing-backend.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
